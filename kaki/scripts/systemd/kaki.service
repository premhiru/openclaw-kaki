[Unit]
Description=Kaki household agent gateway
Documentation=https://docs.openclaw.ai/cli/gateway
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=kaki
Group=kaki
WorkingDirectory=/opt/kaki
Environment=HOME=/var/lib/kaki
Environment=KAKI_HOME=/var/lib/kaki
Environment=NODE_ENV=production
EnvironmentFile=-/etc/kaki/kaki.env
ExecStart=/usr/bin/node /opt/kaki/kaki.mjs gateway run --bind loopback --port 18789
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=5s
TimeoutStopSec=60s
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/kaki
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
