{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaki.local/schema/live-evidence.schema.json",
  "title": "Kaki live acceptance evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "liveId",
    "passed",
    "fixtureMode",
    "checkedAt",
    "operator",
    "build"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "liveId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "passed": { "type": "boolean" },
    "fixtureMode": { "const": false },
    "checkedAt": { "type": "string", "format": "date-time" },
    "operator": { "type": "string", "minLength": 1, "maxLength": 120 },
    "build": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "notes": { "type": "string" },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
